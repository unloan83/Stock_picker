# Morning TV shortlist: records the business channels 08:30-09:15 IST and sends the shortlist to Telegram.
# Copy this and tv-shortlist.timer to /etc/systemd/system/, adjust User and paths, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now tv-shortlist.timer
[Unit]
Description=Stock Finder morning TV shortlist
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stockfinder
WorkingDirectory=/opt/stock_picker
EnvironmentFile=/opt/stock_picker/.env
ExecStart=/opt/stock_picker/.venv/bin/python -m stock_finder tv
TimeoutStartSec=2h
Nice=5
