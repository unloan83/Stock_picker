# Copy to .env and fill in. Never commit .env.
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat ids allowed to use the bot (message the bot once; it replies with your id)
ALLOWED_CHAT_IDS=
# Where every recommendation is logged (for later accuracy checks)
STOCK_FINDER_DB=stock_finder.db
# Cached copy of NSE's equity list, used to match company names (refreshed daily)
NSE_LIST_CACHE=nse_equity_list.csv
