# Copy to .env and fill in. Never commit .env.
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat ids allowed to use the bot (message the bot once; it replies with your id)
ALLOWED_CHAT_IDS=
# Where every recommendation is logged (for later accuracy checks)
STOCK_FINDER_DB=stock_finder.db
# Cached copy of NSE's equity list, used to match company names (refreshed daily)
NSE_LIST_CACHE=nse_equity_list.csv
# Morning TV shortlist (optional; deploy/install.sh sets it up when GROQ_API_KEY is set)
# Groq API key (console.groq.com, free tier): transcribes the TV audio in the cloud, seconds per 2-minute chunk
GROQ_API_KEY=
# auto (Groq when GROQ_API_KEY is set) / groq / local (faster-whisper on this machine: pip install -e ".[tv-local]")
TV_TRANSCRIBER=auto
# Folder for daily transcripts (kept for checking what was matched)
TV_DIR=tv_transcripts
# Local Whisper model when TV_TRANSCRIBER=local: tiny / base / small / medium (bigger = more accurate, slower)
TV_WHISPER_MODEL=base
# 1 = keep the recorded WAV chunks in TV_DIR/<date>/audio (for comparing models); they are deleted otherwise
TV_KEEP_AUDIO=0
# If YouTube challenges the server ("confirm you're not a bot"): path to a cookies.txt exported from a browser that is
# signed in to YouTube, and/or extra yt-dlp options (e.g. --proxy http://host:port)
TV_YTDLP_COOKIES=
TV_YTDLP_ARGS=
# Override the channel list: "Name|youtube live url|hi or en;..." (blank = the four default channels)
TV_CHANNELS=
