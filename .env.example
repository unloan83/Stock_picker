# Copy to .env and fill in. Never commit .env.
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat ids allowed to use the bot (message the bot once; it replies with your id)
ALLOWED_CHAT_IDS=
# Where every recommendation is logged (for later accuracy checks)
STOCK_FINDER_DB=stock_finder.db
# Cached copy of NSE's equity list, used to match company names (refreshed daily)
NSE_LIST_CACHE=nse_equity_list.csv
# Morning TV shortlist (optional; needs: pip install -e ".[tv]" and ffmpeg)
# Folder for daily transcripts (kept for checking what was matched)
TV_DIR=tv_transcripts
# Whisper model: tiny / base / small / medium (bigger is more accurate but slower on CPU)
TV_WHISPER_MODEL=base
# 1 = keep the recorded WAV chunks in TV_DIR/<date>/audio (for comparing models); they are deleted otherwise
TV_KEEP_AUDIO=0
# Override the channel list: "Name|youtube live url|hi or en;..." (blank = the four default channels)
TV_CHANNELS=
